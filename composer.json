{
    "name": "pdphilip/omnicron",
    "description": "Unify your Laravel cron jobs into loggable, self-describing tasks with a queryable run history",
    "keywords": ["laravel", "cron", "scheduler", "tasks", "monitoring"],
    "homepage": "https://github.com/pdphilip/omnicron",
    "license": "MIT",
    "authors": [
        {
            "name": "David Philip",
            "email": "pd.philip@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "dragonmantank/cron-expression": "^3.3",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^2.9",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.1.1||^7.10.0",
        "orchestra/testbench": "^9.0.0||^8.22.0",
        "pestphp/pest": "^2.34",
        "pestphp/pest-plugin-laravel": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "PDPhilip\\OmniCron\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PDPhilip\\OmniCron\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PDPhilip\\OmniCron\\OmniCronServiceProvider"
            ],
            "aliases": {
                "OmniCron": "PDPhilip\\OmniCron\\Facades\\OmniCron"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
