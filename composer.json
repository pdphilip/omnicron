{
    "name": "pdphilip/omnicron",
    "description": "Unify your Laravel cron jobs into loggable, self-describing tasks with a queryable run history",
    "keywords": [
        "laravel",
        "cron",
        "scheduler",
        "tasks",
        "monitoring"
    ],
    "homepage": "https://github.com/pdphilip/omnicron",
    "license": "MIT",
    "authors": [
        {
            "name": "David Philip",
            "email": "pd.philip@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "dragonmantank/cron-expression": "^3.3",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^9.0||^10.0||^11.0",
        "pestphp/pest": "^3||^4",
        "pestphp/pest-plugin-laravel": "^3||^4",
        "predis/predis": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "PDPhilip\\OmniCron\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PDPhilip\\OmniCron\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:unit": "vendor/bin/pest --colors=always",
        "test:l11": [
            "@composer update --with laravel/framework:^11.0 --prefer-stable --no-interaction --quiet",
            "@test:unit"
        ],
        "test:l12": [
            "@composer update --with laravel/framework:^12.0 --prefer-stable --no-interaction --quiet",
            "@test:unit"
        ],
        "test:l13": [
            "@composer update --with laravel/framework:^13.0 --prefer-stable --no-interaction --quiet",
            "@test:unit"
        ],
        "test:all": [
            "@test:l11",
            "@test:l12",
            "@test:l13"
        ],
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test -v"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PDPhilip\\OmniCron\\OmniCronServiceProvider"
            ],
            "aliases": {
                "OmniCron": "PDPhilip\\OmniCron\\Facades\\OmniCron"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "mongodb/laravel-mongodb": "Keep the run log in MongoDB via the bundled MongoRun model (^5.0)",
        "pdphilip/elasticsearch": "Keep the run log in Elasticsearch via the bundled EsRun model (^5.0)"
    }
}
